# Stripe secret. Required on any shared, public, or production deploy.
# When unset, a release code is issued without payment ONLY if ALLOW_UNPAID_DEMO
# is set (below) on loopback `next dev`. Host headers cannot enable that path.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Base URL used to build Stripe redirect URLs and attendant QR links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-only opt-in for unpaid release codes during loopback `next dev`.
# Leave unset on Vercel, tunnels, LAN binds, and production. A request
# X-Forwarded-Host or Host header cannot turn this on. Set to 1 to enable.
ALLOW_UNPAID_DEMO=

# Required. Shared attendant PIN. There is no default — the console stays
# locked until this is set. The PIN is submitted with POST and is not put in the URL.
# A successful PIN creates an opaque random session cookie (not HMAC of the PIN).
ATTENDANT_PIN=

# Required to enable POST /api/admin/reset. Send it in the X-Admin-Secret header.
# Leave unset to keep reset disabled (every call is rejected).
ADMIN_RESET_SECRET=
